# Copy this file to .env in the same folder and fill in real values.
# docker-compose automatically loads .env from this directory.

DOCKERHUB_USERNAME=yourusername
IMAGE_TAG=latest
APP_ENV=dev

# For local testing on Docker Desktop (Windows/Mac), use host.docker.internal
# to reach a backend container running on your own machine.
BACKEND_URL=http://host.docker.internal:5000

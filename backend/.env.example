# Copy this file to .env in the same folder and fill in real values.
# docker-compose automatically loads .env from this directory.

DOCKERHUB_USERNAME=yourusername
IMAGE_TAG=latest
APP_ENV=dev

# MongoDB Atlas (or other managed Mongo) connection string
MONGO_URI=mongodb+srv://username:password@yourcluster.mongodb.net/studentdb

# Admin dashboard login - CHANGE these before deploying anywhere real
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-to-a-long-random-string

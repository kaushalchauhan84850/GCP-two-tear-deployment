# Copy this file to .env.qa in the terraform/ folder and fill in real values.
# Terraform automatically picks up any TF_VAR_<name> environment variable
# as the value for variable "<name>" - no -var flags needed once loaded.
# Load it with:  . ..\scripts\load-env.ps1 .env.qa   (run from terraform/)

TF_VAR_dockerhub_username=yourusername
TF_VAR_image_tag=qa
TF_VAR_mongo_uri=mongodb+srv://username:password@yourcluster.mongodb.net/studentdb
TF_VAR_admin_username=admin
TF_VAR_admin_password=change-this-password
TF_VAR_jwt_secret=change-this-to-a-long-random-string
